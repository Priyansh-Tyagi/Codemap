# Copy this file to .env (same folder - backend/app/.env) and fill in what
# you need. .env is loaded automatically when you run uvicorn; nothing here
# is required to run CodeMap at all - everything below is optional.
#
# .env is in .gitignore - never commit your real one.

# ---- GitHub sign-in (optional - see README "GitHub sign-in") ----
# From a GitHub OAuth App you register at https://github.com/settings/developers
# (callback URL: http://localhost:8000/api/auth/github/callback for local dev)
CODEMAP_GITHUB_CLIENT_ID=
CODEMAP_GITHUB_CLIENT_SECRET=

# Where to send the browser after a successful sign-in.
CODEMAP_FRONTEND_URL=http://localhost:5173

# Encrypts GitHub tokens at rest. Without this, a random key is generated
# each time you start the server, and every signed-in session is invalidated
# on restart. Generate a real one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CODEMAP_SECRET_KEY=

# Only needed once frontend and backend are on different domains (a real
# deployment, not local dev). Leave unset locally.
# CODEMAP_COOKIE_SECURE=true

# ---- GitHub API (optional) ----
# Raises the ANONYMOUS GitHub API rate limit from 60/hour to 5,000/hour.
# A plain personal access token, no special scopes needed for public repos:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# ---- Guided tour AI narration (optional) ----
# From https://aistudio.google.com/apikey . Leave unset to offer the
# deterministic guided tour without the AI narration button.
GEMINI_API_KEY=
# The model used for narration - change it HERE (and restart), never in code.
# Model IDs get retired and some need a paid plan; see https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash

# ---- Security (see README "Security") ----
# Analyzing a folder on THIS machine. Off by default, and it must stay off on
# any server other people can reach - it lets any visitor map the server's own
# files. For local development, uncomment it. (Deliberately commented out here
# so that copying this file to a server cannot turn it on by accident.)
# CODEMAP_ALLOW_LOCAL_PATHS=true
# Optionally confine it to specific folders (separated by ; on Windows, : elsewhere):
# CODEMAP_LOCAL_PATH_ROOTS=C:\Users\you\projects

# Deployments: restrict which Host headers are accepted, and hide the API docs.
# CODEMAP_ALLOWED_HOSTS=api.example.com
# CODEMAP_DISABLE_DOCS=true
# Needed behind a proxy where the redirect URL can't be inferred safely:
# CODEMAP_GITHUB_REDIRECT_URI=https://api.example.com/api/auth/github/callback

# Abuse limits (per client address). Defaults shown.
# CODEMAP_ANALYZE_LIMIT=12              # uncached analyses ...
# CODEMAP_ANALYZE_WINDOW_SECONDS=600    # ... per this many seconds
# CODEMAP_NARRATE_LIMIT=6               # AI narrations per hour
# CODEMAP_GLOBAL_LIMIT=600              # any API request, per minute
# CODEMAP_MAX_PROJECTS=5000             # oldest saved projects are dropped beyond this

# ---- Other ----
# CODEMAP_DB_PATH=                      # default: backend/app/codemap.db
# CODEMAP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
